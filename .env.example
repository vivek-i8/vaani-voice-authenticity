# VAANI V1 backend environment template
# Copy to .env and adjust as needed.

# LLM explanation provider (OpenRouter-compatible)
# With USE_LLM=false the app runs without any API key (mock explanations).
USE_LLM=false

# Required only when USE_LLM=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Audio processing
CONFIDENCE_THRESHOLD=0.6
MIN_AUDIO_DURATION=3.0
MAX_AUDIO_DURATION=5.0
SAMPLE_RATE=16000
MAX_CLIPS=10
